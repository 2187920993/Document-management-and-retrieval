# Keep Compose independent of the project folder name, including Chinese paths.
COMPOSE_PROJECT_NAME=documents_workspace
POSTGRES_PASSWORD=replace-with-a-local-secret
MAX_FILE_BYTES=20971520
MAX_BATCH_DOWNLOAD_BYTES=1073741824
# Embedding options: local is deterministic and requires no credentials.
# Set EMBEDDING_PROVIDER=remote with an OpenAI-compatible /embeddings endpoint
# to use a network model; the API key stays in this environment file only.
EMBEDDING_PROVIDER=local
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Storage paths are relative to this compose file unless an absolute path is supplied.
# Windows example: STORAGE_HOST_PATH=E:/110-data/files
# Leave these defaults unchanged to keep all data inside the project directory.
POSTGRES_HOST_PATH=./runtime/postgres
STORAGE_HOST_PATH=./runtime/storage
STORAGE_LAYOUT=flat
# For local development without Docker, the backend defaults to SQLite at backend/data/app.db.
